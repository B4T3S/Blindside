{% extends 'admin/base.html.twig' %}

{% block body %}
<div class="admin w-screen h-screen px-6 pb-6 pt-22">
    <div class="grid grid-cols-3 gap-6 w-full h-full">
        <div class="cream-bg dark-text p-2 h-fit">
            <div class="flex flex-row justify-center">
                <h1 class="font-bold text-lg w-fit">Total Media</h1>
            </div>
            <h1 class="text-4xl mt-3 text-center font-bold">{{ mediaCount }}</h1>
        </div>
        <div class="cream-bg dark-text p-2 h-fit">
            <div class="flex flex-row justify-center">
                <h1 class="font-bold text-lg w-fit">Total Categories</h1>
            </div>
            <h1 class="text-4xl mt-3 text-center font-bold">{{ categoryCount }}</h1>
        </div>
        <div class="cream-bg dark-text p-2 h-fit">
            <div class="flex flex-row justify-center">
                <h1 class="font-bold text-lg w-fit">Total Options</h1>
            </div>
            <h1 class="text-4xl mt-3 text-center font-bold">{{ optionCount }}</h1>
        </div>
    </div>
</div>
{% endblock %}
