<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="/static/css/index.css" />
        <link rel="stylesheet" href="/static/assets/fontawesome/css/fontawesome.css" />
        <link rel="stylesheet" href="/static/assets/fontawesome/css/solid.css" />
        <title>Blindside? - Admin panel</title>
    </head>
    <body class="bg-guess-who h-screen" data-controller="admin">
        <div class="header">
            <div class="flex">
                <img class="h-10 me-2 title-font" src="/static/assets/images/placeholder-icon.svg" alt="Placeholder icon" />
                <a class="text-4xl font-bold title-font">Blindside</a>
                <h4 class="text-lg ms-4 mt-auto title-font">
                    Admin Panel
                </h4>
            </div>
            <div class="flex">
                <button class="text-2xl p-1 px-3 my-auto btn-red hover:scale-105 inline-block" href="/admin/logout">
                    Log out
                </button>
            </div>
        </div>

        {% block body %}{% endblock %}

        <script type="module" src="/static/js/admin.js"></script>
        {% if hotReload %}
            <script type="module" src="/static/js/hot-reload.js"></script>
        {% endif %}
    </body>

</html>
