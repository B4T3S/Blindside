<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="/static/css/index.css" />
        <link rel="stylesheet" href="/static/assets/fontawesome/css/fontawesome.css" />
        <link rel="stylesheet" href="/static/assets/fontawesome/css/solid.css" />
        <title>Guess Who? - Admin panel</title>
    </head>
    <body class="bg-guess-who h-screen" data-controller="admin">
        <div class="header">
            <div class="flex">
                <a href="/admin" class="text-7xl font-bold title-font">Guess Who?</a>
                <h4 class="text-2xl ms-4 mb-2 mt-auto title-font">
                    Admin Panel
                </h4>
            </div>
            <div class="flex">
                <button class="text-4xl p-2 px-4 my-auto btn-red hover:scale-105 inline-block" href="/admin/logout">
                    Log out
                </button>
            </div>
        </div>

        {% block body %}{% endblock %}

        <script type="module" src="/static/js/admin.js"></script>
        {% if hotReload %}
            <script type="module" src="/static/js/hot-reload.js"></script>
        {% endif %}
    </body>

</html>
