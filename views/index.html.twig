<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="/static/css/index.css" />
        <link rel="stylesheet" href="/static/assets/fontawesome/css/fontawesome.css" />
        <link rel="stylesheet" href="/static/assets/fontawesome/css/solid.css" />
        <title>Deadlock Guess-Who!</title>
    </head>
    <body>
        <div class="header">
            <div class="flex">
                <a href="#" class="text-7xl font-bold title-font">Guess Who?</a>
                <h4 class="text-2xl ms-4 mb-2 mt-auto title-font">
                    Well go on...<i>guess!</i>
                </h4>
            </div>
            <div class="flex">
                <button id="join-room-button" command="show-modal" commandfor="join-game-dialog"
                    class="weird-button transition-all duration-300 hover:scale-105 my-auto!"
                >
                    <span class="text-4xl my-auto weird-button-label">
                        Join a lobby
                    </span>
                </button>

                <button id="leave-room" class="text-4xl p-2 px-4 my-auto btn-red hover:scale-105 inline-block" hidden>
                    Leave lobby
                </button>
            </div>
        </div>

        {% include 'components/game-select.html.twig' %}

        {% include 'components/lobby.html.twig' %}

        {% include 'components/game.html.twig' %}

        {% include 'components/join-game-dialog.html.twig' %}

        <script type="module" src="/static/js/client.js"></script>
        {% if hotReload %}
            <script type="module" src="/static/js/hot-reload.js"></script>
        {% endif %}
    </body>

</html>
