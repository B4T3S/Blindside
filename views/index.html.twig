<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="/static/css/index.css" />
        <link rel="stylesheet" href="/static/assets/fontawesome/css/fontawesome.css" />
        <link rel="stylesheet" href="/static/assets/fontawesome/css/solid.css" />
        <title>Blindside</title>
    </head>
    <body>
        <div class="header">
            <div class="flex">
                <img class="h-10 me-2 title-font" src="/static/assets/images/placeholder-icon.svg" alt="Placeholder icon" />
                <a class="text-4xl font-bold title-font">Blindside</a>
                <h4 class="text-lg ms-4 mb-0 mt-auto title-font">
                    Everyone knows, <i>except you.</i>
                </h4>
            </div>
            <div class="flex">
                <button id="join-room-button" command="show-modal" commandfor="join-game-dialog"
                    class="weird-button transition-all duration-300 hover:scale-105 my-auto!"
                >
                    <span class="text-2xl p-1 px-2 my-auto weird-button-label">
                        Join a lobby
                    </span>
                </button>

                <button id="leave-room" class="text-2xl p-1 px-3 my-auto btn-red hover:scale-105 inline-block" hidden>
                    Leave lobby
                </button>
            </div>
        </div>

        {% include 'components/game-select.html.twig' %}

        {% include 'components/lobby.html.twig' %}

        {% include 'components/game.html.twig' %}

        {% include 'components/join-game-dialog.html.twig' %}

        <div class="md:hidden absolute h-dvh w-dvw flex justify-center place-items-center z-[100] bg-guess-who">
            <div class="weird-bg p-4 text-center">
                <span class="text-xl">ROTATE YOUR DEVICE!</span>
                <p>This website was not designed with portrait mode in mind.</p>
            </div>
        </div>

        <script type="module" src="/static/js/client.js"></script>
        {% if hotReload %}
            <script type="module" src="/static/js/hot-reload.js"></script>
        {% endif %}
    </body>

</html>
