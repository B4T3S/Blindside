<div id="lobby" class="w-screen h-screen fixed z-10 bg-guess-who transition-transform duration-500 ease-in-out">
    <div class="h-full flex items-center justify-center duration-[0]">
        <div class="grid grid-cols-6 gap-8 w-full h-full p-8 pt-[8em]">
            
            <div class="grid">
                <div class="h-fit card-bg">
                    <h1 class="font-bold text-2xl">Players:</h1>
                    <ul id="players"></ul>
                </div>
            </div>

            <div class="grid col-span-5 justify-center">
                <div class="weird-bg p-5 w-fit h-fit my-auto">
                    <h5>Room code: <span id="room-code"></span></h5>
                    <br />
                    <button id="start-game" class="btn-green p-2 px-4 hover:scale-110"
                        >Start game!</button
                    >
                </div>
            </div>

        </div>
    </div>
</div>

<template id="player-name">
    <li></li>
</template>