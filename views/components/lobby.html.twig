<div id="lobby" class="w-screen h-screen fixed z-10 bg-guess-who transition-transform duration-500 ease-in-out" data-controller="lobby">
    <div data-lobby-target="splashart" class="absolute w-screen h-screen background-splash">
    </div>

    <div class="h-full flex items-center justify-center duration-[0]">
        <div class="grid grid-cols-6 gap-8 w-full h-full p-8 pt-[6em]">

            <div class="grid">
                <div class="h-fit card-bg">
                    <h1 class="font-bold text-2xl title-font">Players:</h1>
                    <ul id="players"></ul>
                </div>
            </div>

            <div class="grid col-span-4 justify-center">
                <div class="weird-bg py-3 px-5 h-fit my-auto text-3xl">
                    Waiting for host to start the game...
                </div>
            </div>

            <div class="grid">
                <div id="lobby-settings" class="h-fit card-bg" hidden>
                    <h1 class="font-bold text-2xl title-font">Lobby settings:</h1>

                    <div class="flex flex-row">
                        <span class="flex me-1">Code:</span>
                        <span id="room-code" class="tracking-wider flex me-1"></span>
                        <button type="button" id="copy-lobby-code" class="h-fit flex my-auto text-stone-400 ">
                            <i class="fa-solid fa-copy text-sm"></i>
                        </button>
                    </div>

                    <div class="flex flex-col">
                        <label class="input-label">Media:</label>
                        <select id="media-select" class="w-full" required data-lobby-target="medias" data-action="lobby#updateCategories">
                            <option value="" default false>Select media...</option>
                        </select>
                    </div>

                    <div class="flex flex-col">
                        <label class="input-label">Category:</label>
                        <select id="category-select" class="w-full" required data-lobby-target="categories">
                            <option value="" default selected disabled>Select category...</option>
                        </select>
                    </div>

                    <div class="flex flex-col mt-10">
                        <div>
                            <button id="start-game" class="btn-green p-2 px-4 hover:scale-110">
                                Start game!
                            </button>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<template id="player-name">
    <li class="flex flex-row w-full justify-between">
        <span class="name"></span>
        <span class="score"></span>
    </li>
</template>
