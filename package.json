{
  "type": "module",
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "animejs": "^4.5.0",
    "connect-sqlite3": "^0.9.18",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "playsocketjs": "^5.2.1",
    "sqlite3": "^6.0.1",
    "twig": "^3.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run serve\" \"npm run tailwind:watch\" \"npm run bundle:watch\"",
    "serve": "node --watch --watch-path=./src/backend --watch-path=./views ./src/backend/server.js",
    "prod": "node ./src/backend/server.js",
    "tailwind": "npx @tailwindcss/cli -i ./src/css/index.css -o ./static/css/index.css",
    "tailwind:watch": "npx @tailwindcss/cli -i ./src/css/index.css -o ./static/css/index.css --watch",
    "bundle": "npx esbuild src/js/*.js --bundle --minify --platform=browser --format=esm --outdir=static/js",
    "bundle:watch": "npx esbuild src/js/*.js --bundle --minify --platform=browser --format=esm --outdir=static/js --watch",
    "admin": "node ./scripts/admin.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "ws": "^8.22.0"
  }
}
