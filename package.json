{
  "type": "module",
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "express": "^5.2.1",
    "playsocketjs": "^5.2.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vite": "^8.3.2"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch ./src/server.js",
    "dev:client": "vite --host 0.0.0.0 --port 3001 -c ./vite.config.js ./src/public"
  }
}
